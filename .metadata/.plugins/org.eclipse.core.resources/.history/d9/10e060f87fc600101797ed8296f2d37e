package repositorioSQL;

import java.sql.*;
import conexion.ConexionMySql;
import Modelado.Entrega;

public class EntregaDAO {

    public int registrarEntrega(Entrega e) {
        int idGenerado = -1;

        String sql = "{CALL registrarEntrega(?,?,?)}";

        try (Connection cn = ConexionMySql.getConexion();
             CallableStatement cs = cn.prepareCall(sql)) {

            cs.setString(1, e.getDniMotorizado());
            cs.setInt(2, e.getCantidad());
            cs.setString(3, e.getFecha());

            cs.executeUpdate();

            // ahora recuperamos el último ID insertado
            ResultSet rs = cs.getGeneratedKeys();
            if (rs.next()) {
                idGenerado = rs.getInt(1);
            }

        } catch (Exception ex) {
            ex.printStackTrace();
        }

        return idGenerado;
    }
}
