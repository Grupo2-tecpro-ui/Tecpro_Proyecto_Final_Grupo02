package repositorio;

import java.sql.*;
import Modelado.DetalleEntrega;

public class DetalleEntregaDAO {

    public void registrarDetalle(DetalleEntrega d, int idEntrega) {
        String sql = "INSERT INTO detalle_entrega(idEntrega, cliente, banco, direccion, conforme) "
                   + "VALUES (?, ?, ?, ?, ?)";

        try (Connection con = Conexion.getConexion();
             PreparedStatement pst = con.prepareStatement(sql)) {

            pst.setInt(1, idEntrega);
            pst.setString(2, d.getCliente());
            pst.setString(3, d.getBanco());
            pst.setString(4, d.getDireccion());
            pst.setBoolean(5, d.isConforme());

            pst.executeUpdate();

        } catch (Exception ex) {
            ex.printStackTrace();
        }
    }
}
