package repositorio;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

import Modelado.DetalleEntrega;

public class DetalleEntregaDAO {

    public void registrarDetalle(DetalleEntrega d, int idEntrega) {
        String sql = "INSERT INTO detalle_entrega(idEntrega, cliente, banco, direccion, conforme) "
                   + "VALUES (?, ?, ?, ?, ?)";

        try (Connection con = Conexion.getConexion();
             PreparedStatement pst = con.prepareStatement(sql)) {

            pst.setInt(1, idEntrega);
            pst.setString(2, d.getCliente());
            pst.setString(3, d.getBanco());
            pst.setString(4, d.getDireccion());
            pst.setBoolean(5, d.isConforme());

            pst.executeUpdate();

        } catch (Exception ex) {
            ex.printStackTrace();
        }
    }
    public List<DetalleEntrega> listarPorEntrega(int idEntrega) {
        List<DetalleEntrega> lista = new ArrayList<>();

        String sql = "SELECT * FROM detalle_entrega WHERE idEntrega = ?";

        try (Connection con = Conexion.getConexion();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setInt(1, idEntrega);
            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                DetalleEntrega d = new DetalleEntrega(
                    rs.getInt("idDetalle"),
                    rs.getString("cliente"),
                    rs.getString("banco"),
                    rs.getString("direccion"),
                    rs.getBoolean("conforme")
                );
                lista.add(d);
            }

        } catch (Exception ex) {
            ex.printStackTrace();
        }

        return lista;
    }
    
}
