package GUI;

import javax.swing.*;
import javax.swing.border.EmptyBorder;
import javax.swing.SpinnerDateModel;
import java.awt.*;
import java.util.Date;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import Controlador.ControladorMotorizado;
import Modelado.Motorizado;

public class RegistroMotorizadoFrame extends JDialog implements ActionListener {

    private static final long serialVersionUID = 1L;

    // PALETA PROSEGUR
    private static final Color PROSEGUR_YELLOW = new Color(255, 209, 0);
    private static final Color PROSEGUR_BLACK = new Color(18, 18, 18);
    private static final Color PROSEGUR_GRAY = new Color(230, 230, 230);

    private JTextField txtDni, txtNombres, txtApellidos, txtCelular, txtPlaca, txtMarca, txtModelo;
    private JTextField txtVencBrevete, txtFechaIngreso, txtTarjetas;
    private JTextField txtBrevete;
    private JCheckBox chkSoat;
    private JComboBox<String> cboEstado;
    private JComboBox<String> cboContrato;
    private JComboBox<String> cboSede;

    private JSpinner spinnerFechaTarjetas;

    private JButton btnGuardar, btnLimpiar, btnEnlistar;

    private ControladorMotorizado controlador;

    public RegistroMotorizadoFrame(JFrame parent, ControladorMotorizado controlador) {

        super(parent, "Registro de Motorizado", true);
        this.controlador = controlador;

        setSize(700, 750);
        setLocationRelativeTo(parent);
        setDefaultCloseOperation(JDialog.DISPOSE_ON_CLOSE);

        JPanel content = new JPanel(new BorderLayout());
        content.setBackground(PROSEGUR_GRAY);
        content.setBorder(new EmptyBorder(20, 20, 20, 20));
        setContentPane(content);

        // ----------------------------
        // TÍTULO
        // ----------------------------
        JLabel titulo = new JLabel("Registro de Motorizado", SwingConstants.CENTER);
        titulo.setFont(new Font("Montserrat", Font.BOLD, 26));
        titulo.setForeground(PROSEGUR_BLACK);
        titulo.setBorder(new EmptyBorder(10, 0, 20, 0));
        content.add(titulo, BorderLayout.NORTH);

        // ----------------------------
        // FORMULARIO CENTRAL
        // ----------------------------
        JPanel form = new JPanel(new GridBagLayout());
        form.setBackground(Color.WHITE);
        form.setBorder(new EmptyBorder(25, 25, 25, 25));
        content.add(form, BorderLayout.CENTER);

        GridBagConstraints c = new GridBagConstraints();
        c.insets = new Insets(8, 8, 8, 8);
        c.fill = GridBagConstraints.HORIZONTAL;

        // ---------- MÉTODO PARA AGREGAR CAMPOS ----------
        int fila = 0;

        txtDni = addField("DNI:", form, c, fila++);
        txtNombres = addField("Nombres:", form, c, fila++);
        txtApellidos = addField("Apellidos:", form, c, fila++);
        txtCelular = addField("Celular trabajo:", form, c, fila++);
        txtPlaca = addField("Placa moto:", form, c, fila++);
        txtMarca = addField("Marca moto:", form, c, fila++);
        txtModelo = addField("Modelo moto:", form, c, fila++);
        txtBrevete = addField("Brevete categoría:", form, c, fila++);

        txtVencBrevete = addField("Venc. brevete (YYYY-MM-DD):", form, c, fila++);
        txtVencBrevete.setText("2026-12-31");

        // SOAT obligatorio
        JLabel lblSoat = new JLabel("SOAT vigente:");
        lblSoat.setFont(new Font("Montserrat", Font.PLAIN, 14));
        c.gridx = 0; c.gridy = fila; c.weightx = 0.3;
        form.add(lblSoat, c);

        chkSoat = new JCheckBox("Marcar si está vigente");
        chkSoat.setBackground(Color.WHITE);
        c.gridx = 1; c.weightx = 0.7;
        form.add(chkSoat, c);
        fila++;

        // Estado
        JLabel lblEstado = new JLabel("Estado:");
        lblEstado.setFont(new Font("Montserrat", Font.PLAIN, 14));
        c.gridx = 0; c.gridy = fila;
        form.add(lblEstado, c);

        cboEstado = new JComboBox<>(new String[]{"Activo", "Inactivo"});
        c.gridx = 1;
        form.add(cboEstado, c);
        fila++;

        txtFechaIngreso = addField("Fecha ingreso (YYYY-MM-DD):", form, c, fila++);
        txtFechaIngreso.setText("2025-01-01");

        // Contrato
        JLabel lblContrato = new JLabel("Tipo contrato:");
        lblContrato.setFont(new Font("Montserrat", Font.PLAIN, 14));
        c.gridx = 0; c.gridy = fila;
        form.add(lblContrato, c);

        cboContrato = new JComboBox<>(new String[]{"Express", "Tiempo completo", "Medio tiempo"});
        c.gridx = 1;
        form.add(cboContrato, c);
        fila++;

        // Sede
        JLabel lblSede = new JLabel("Sede:");
        lblSede.setFont(new Font("Montserrat", Font.PLAIN, 14));
        c.gridx = 0; c.gridy = fila;
        form.add(lblSede, c);

        cboSede = new JComboBox<>(new String[]{"1 - Miraflores", "2 - Surco", "3 - Tambo Norte"});
        c.gridx = 1;
        form.add(cboSede, c);
        fila++;

        txtTarjetas = addField("Cantidad de tarjetas:", form, c, fila++);
        txtTarjetas.setText("0");

        // Fecha de ruta
        JLabel lblFechaRuta = new JLabel("Fecha de ruta (YYYY-MM-DD):");
        lblFechaRuta.setFont(new Font("Montserrat", Font.PLAIN, 14));
        c.gridx = 0; c.gridy = fila;
        form.add(lblFechaRuta, c);

        SpinnerDateModel modelDate = new SpinnerDateModel(new Date(), null, null, java.util.Calendar.DAY_OF_MONTH);
        spinnerFechaTarjetas = new JSpinner(modelDate);
        spinnerFechaTarjetas.setEditor(new JSpinner.DateEditor(spinnerFechaTarjetas, "yyyy-MM-dd"));
        c.gridx = 1;
        form.add(spinnerFechaTarjetas, c);
        fila++;

        // ----------------------------
        // BOTONES INFERIORES
        // ----------------------------
        JPanel buttons = new JPanel(new FlowLayout());
        buttons.setBackground(PROSEGUR_GRAY);
        content.add(buttons, BorderLayout.SOUTH);

        btnGuardar = new JButton("Guardar");
        btnGuardar.setBackground(PROSEGUR_YELLOW);
        btnGuardar.setForeground(PROSEGUR_BLACK);
        btnGuardar.setFont(new Font("Montserrat", Font.BOLD, 14));
        buttons.add(btnGuardar);

        btnLimpiar = new JButton("Limpiar");
        btnLimpiar.setBackground(PROSEGUR_BLACK);
        btnLimpiar.setForeground(Color.WHITE);
        btnLimpiar.setFont(new Font("Montserrat", Font.BOLD, 14));
        buttons.add(btnLimpiar);

        btnEnlistar = new JButton("Reportar");
        btnEnlistar.setBackground(new Color(30, 30, 30));
        btnEnlistar.setForeground(PROSEGUR_YELLOW);
        btnEnlistar.setFont(new Font("Montserrat", Font.BOLD, 14));
        buttons.add(btnEnlistar);

        // Eventos
        btnGuardar.addActionListener(e -> guardar());
        btnLimpiar.addActionListener(e -> limpiar());
        btnEnlistar.addActionListener(this);
    }


    // ------------------------------
    // MÉTODO PARA CREAR CAMPOS
    // ------------------------------
    private JTextField addField(String labelText, JPanel panel, GridBagConstraints c, int fila) {
        JLabel label = new JLabel(labelText);
        label.setFont(new Font("Montserrat", Font.PLAIN, 14));

        c.gridx = 0; 
        c.gridy = fila;
        c.weightx = 0.3;
        panel.add(label, c);

        JTextField txt = new JTextField();
        txt.setFont(new Font("Montserrat", Font.PLAIN, 14));

        c.gridx = 1;
        c.weightx = 0.7;
        panel.add(txt, c);

        return txt;
    }


    // ------------------------------
    // GUARDAR
    // ------------------------------
    private void guardar() {

        try {

            if (!chkSoat.isSelected()) {
                JOptionPane.showMessageDialog(this,
                        "No se puede contratar a un motorizado SIN SOAT vigente.");
                return;
            }

            String dni = txtDni.getText().trim();
            if (!dni.matches("\\d{8}")) {
                JOptionPane.showMessageDialog(this, "El DNI debe contener 8 dígitos.");
                return;
            }

            if (repositorio.InMemoryDatabase.existeDni(dni)) {
                JOptionPane.showMessageDialog(this, "Este DNI ya está registrado.");
                return;
            }

            int tarjetas = Integer.parseInt(txtTarjetas.getText().trim());

            String sedeString = (String) cboSede.getSelectedItem();
            int idSede = Integer.parseInt(sedeString.substring(0, 1));

            java.util.Date fechaUtil = (java.util.Date) spinnerFechaTarjetas.getValue();
            java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat("yyyy-MM-dd");
            String fechaTarjetasStr = sdf.format(fechaUtil);

            Motorizado m = new Motorizado(
                    0,
                    dni,
                    txtNombres.getText().trim(),
                    txtApellidos.getText().trim(),
                    txtCelular.getText().trim(),
                    txtPlaca.getText().trim(),
                    txtMarca.getText().trim(),
                    txtModelo.getText().trim(),
                    txtBrevete.getText().trim(),
                    txtVencBrevete.getText().trim(),
                    true,
                    (String) cboEstado.getSelectedItem(),
                    txtFechaIngreso.getText().trim(),
                    (String) cboContrato.getSelectedItem(),
                    tarjetas,
                    false,
                    fechaTarjetasStr,
                    idSede
            );

            controlador.guardarMotorizado(m);

            limpiar();
            JOptionPane.showMessageDialog(this, "Motorizado registrado correctamente.");

        } catch (Exception ex) {
            ex.printStackTrace();
            JOptionPane.showMessageDialog(this, "Error al guardar: " + ex.getMessage());
        }
    }


    private void limpiar() {
        txtDni.setText("");
        txtNombres.setText("");
        txtApellidos.setText("");
        txtCelular.setText("");
        txtPlaca.setText("");
        txtMarca.setText("");
        txtModelo.setText("");
        txtBrevete.setText("");
        txtVencBrevete.setText("2026-12-31");
        chkSoat.setSelected(false);
        txtFechaIngreso.setText("2025-01-01");
        cboEstado.setSelectedIndex(0);
        cboContrato.setSelectedIndex(0);
        cboSede.setSelectedIndex(0);
        txtTarjetas.setText("0");
    }


    @Override
    public void actionPerformed(ActionEvent e) {
        if (e.getSource() == btnEnlistar) {
            ListadoMotorizadoFrame listado =
                    new ListadoMotorizadoFrame(
                            (JFrame) SwingUtilities.getWindowAncestor(this),
                            this.controlador
                    );
            listado.setVisible(true);
        }
    }
}
