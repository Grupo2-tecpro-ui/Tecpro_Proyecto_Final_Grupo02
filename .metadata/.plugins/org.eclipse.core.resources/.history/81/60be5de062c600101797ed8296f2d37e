package GUI;

import javax.swing.*;
import java.awt.*;
import Controlador.ControladorMotorizado;
import Modelado.Motorizado;
import java.util.Date;
import java.awt.event.ActionListener;
import java.awt.event.ActionEvent;

public class RegistroMotorizadoFrame extends JDialog implements ActionListener {

    private static final long serialVersionUID = 1L;

    private JTextField txtDni, txtNombres, txtApellidos, txtCelular, txtPlaca, txtMarca, txtModelo;
    private JTextField txtVencBrevete, txtFechaIngreso, txtTarjetas;
    private JCheckBox chkSoat;
    private JButton btnGuardar, btnLimpiar;
    private JSpinner spinnerFechaTarjetas;
    private JComboBox<String> cboEstado;
    private JTextField txtBrevete;
    private JComboBox<String> cboContrato;
    private JComboBox<String> cboSede;
    private ControladorMotorizado controlador;
    private JButton btnEnlistar;

    public RegistroMotorizadoFrame(JFrame parent, ControladorMotorizado controlador) {

        super(parent, "Registro de Motorizado", true);
        this.controlador = controlador;

        setSize(600, 650);
        setLocationRelativeTo(parent);
        setDefaultCloseOperation(JDialog.DISPOSE_ON_CLOSE);

        JPanel panel = new JPanel();
        panel.setLayout(null);

        int xLabel = 50;
        int xField = 230;
        int y = 60;
        int dy = 35;

        JLabel titulo = new JLabel("🚚 Registro de Motorizado");
        titulo.setFont(new Font("Montserrat", Font.BOLD, 20));
        titulo.setBounds(150, 15, 350, 25);
        panel.add(titulo);

        // ------------------------- CAMPOS -------------------------

        panel.add(crearLabel("🪪 DNI:", xLabel, y));
        txtDni = crearField(xField, y);
        panel.add(txtDni);

        y += dy;
        panel.add(crearLabel("👤 Nombres:", xLabel, y));
        txtNombres = crearField(xField, y);
        panel.add(txtNombres);

        y += dy;
        panel.add(crearLabel("👥 Apellidos:", xLabel, y));
        txtApellidos = crearField(xField, y);
        panel.add(txtApellidos);

        y += dy;
        panel.add(crearLabel("📱 Celular:", xLabel, y));
        txtCelular = crearField(xField, y);
        panel.add(txtCelular);

        y += dy;
        panel.add(crearLabel("🏍️ Placa:", xLabel, y));
        txtPlaca = crearField(xField, y);
        panel.add(txtPlaca);

        y += dy;
        panel.add(crearLabel("🏍️ Marca:", xLabel, y));
        txtMarca = crearField(xField, y);
        panel.add(txtMarca);

        y += dy;
        panel.add(crearLabel("🏍️ Modelo:", xLabel, y));
        txtModelo = crearField(xField, y);
        panel.add(txtModelo);

        y += dy;
        panel.add(crearLabel("🪪 Brevete:", xLabel, y));
        txtBrevete = crearField(xField, y);
        panel.add(txtBrevete);

        y += dy;
        panel.add(crearLabel("📅 Venc. Brevete:", xLabel, y));
        txtVencBrevete = crearField(xField, y);
        txtVencBrevete.setText("2026-12-31");
        panel.add(txtVencBrevete);

        y += dy;
        panel.add(crearLabel("🛡️ SOAT:", xLabel, y));
        chkSoat = new JCheckBox("SOAT vigente");
        chkSoat.setBounds(xField, y, 200, 23);
        panel.add(chkSoat);

        y += dy;
        panel.add(crearLabel("📌 Estado:", xLabel, y));
        cboEstado = new JComboBox<>(new String[]{"Activo", "Inactivo"});
        cboEstado.setBounds(xField, y, 200, 23);
        panel.add(cboEstado);

        y += dy;
        panel.add(crearLabel("📅 F. Ingreso:", xLabel, y));
        txtFechaIngreso = crearField(xField, y);
        txtFechaIngreso.setText("2025-01-01");
        panel.add(txtFechaIngreso);

        y += dy;
        panel.add(crearLabel("📄 Contrato:", xLabel, y));
        cboContrato = new JComboBox<>(new String[]{"Express", "Tiempo completo", "Medio tiempo"});
        cboContrato.setBounds(xField, y, 200, 23);
        panel.add(cboContrato);

        y += dy;
        panel.add(crearLabel("📍 Sede:", xLabel, y));
        cboSede = new JComboBox<>(new String[]{
            "1 - Miraflores",
            "2 - Surco",
            "3 - Tambo Norte"
        });
        cboSede.setBounds(xField, y, 200, 23);
        panel.add(cboSede);

        y += dy;
        panel.add(crearLabel("💳 Tarjetas:", xLabel, y));
        txtTarjetas = crearField(xField, y);
        txtTarjetas.setText("0");
        panel.add(txtTarjetas);

        y += dy;
        panel.add(crearLabel("📅 Fecha ruta:", xLabel, y));
        spinnerFechaTarjetas = new JSpinner(new SpinnerDateModel(new Date(), null, null, java.util.Calendar.DAY_OF_MONTH));
        JSpinner.DateEditor editor = new JSpinner.DateEditor(spinnerFechaTarjetas, "yyyy-MM-dd");
        spinnerFechaTarjetas.setEditor(editor);
        spinnerFechaTarjetas.setBounds(xField, y, 200, 23);
        panel.add(spinnerFechaTarjetas);

        // ------------------------- BOTONES -------------------------

        btnGuardar = new JButton("💾 Guardar");
        btnGuardar.setBounds(70, 570, 140, 30);
        btnGuardar.addActionListener(e -> guardar());
        panel.add(btnGuardar);

        btnLimpiar = new JButton("🧹 Limpiar");
        btnLimpiar.setBounds(230, 570, 120, 30);
        btnLimpiar.addActionListener(e -> limpiar());
        panel.add(btnLimpiar);

        btnEnlistar = new JButton("📋 Reportar");
        btnEnlistar.setBounds(370, 570, 140, 30);
        btnEnlistar.addActionListener(this);
        panel.add(btnEnlistar);

        getContentPane().add(panel);
    }

    // -------------------------------------------------------------------
    // Funciones auxiliares para crear labels y campos
    // -------------------------------------------------------------------

    private JLabel crearLabel(String txt, int x, int y) {
        JLabel lbl = new JLabel(txt);
        lbl.setBounds(x, y, 180, 23);
        lbl.setFont(new Font("Segoe UI Emoji", Font.BOLD, 13));
        return lbl;
    }

    private JTextField crearField(int x, int y) {
        JTextField txt = new JTextField();
        txt.setBounds(x, y, 250, 23);
        return txt;
    }

    // -------------------------------------------------------------------
    // GUARDAR — Con todas tus reglas incluidas
    // -------------------------------------------------------------------
    private void guardar() {
        try {

            if (!chkSoat.isSelected()) {
                JOptionPane.showMessageDialog(this,
                        "❌ No se puede registrar a un motorizado sin SOAT vigente.");
                return;
            }

            String dni = txtDni.getText().trim();
            if (!dni.matches("\\d{8}")) {
                JOptionPane.showMessageDialog(this, "DNI inválido (8 dígitos requeridos).");
                return;
            }

            if (repositorio.InMemoryDatabase.existeDni(dni)) {
                JOptionPane.showMessageDialog(this, "El DNI ya existe.");
                return;
            }

            String sedeString = (String) cboSede.getSelectedItem();
            int idSede = Integer.parseInt(sedeString.substring(0, 1));

            int tarjetas = Integer.parseInt(txtTarjetas.getText().trim());

            java.util.Date fechaUtil = (java.util.Date) spinnerFechaTarjetas.getValue();
            java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat("yyyy-MM-dd");
            String fechaTarjetasStr = sdf.format(fechaUtil);

            Motorizado m = new Motorizado(
                0, dni,
                txtNombres.getText().trim(),
                txtApellidos.getText().trim(),
                txtCelular.getText().trim(),
                txtPlaca.getText().trim(),
                txtMarca.getText().trim(),
                txtModelo.getText().trim(),
                txtBrevete.getText().trim(),
                txtVencBrevete.getText().trim(),
                true,
                (String) cboEstado.getSelectedItem(),
                txtFechaIngreso.getText().trim(),
                (String) cboContrato.getSelectedItem(),
                tarjetas,
                false,
                fechaTarjetasStr,
                idSede
            );

            controlador.guardarMotorizado(m);
            JOptionPane.showMessageDialog(this, "Motorizado guardado correctamente.");
            limpiar();

        } catch (Exception ex) {
            ex.printStackTrace();
            JOptionPane.showMessageDialog(this, "Error: " + ex.getMessage());
        }
    }

    private void limpiar() {
        txtDni.setText("");
        txtNombres.setText("");
        txtApellidos.setText("");
        txtCelular.setText("");
        txtPlaca.setText("");
        txtMarca.setText("");
        txtModelo.setText("");
        txtBrevete.setText("");
        txtVencBrevete.setText("2026-12-31");
        chkSoat.setSelected(false);
        cboEstado.setSelectedIndex(0);
        txtFechaIngreso.setText("2025-01-01");
        cboContrato.setSelectedIndex(0);
        cboSede.setSelectedIndex(0);
        txtTarjetas.setText("0");
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        if (e.getSource() == btnEnlistar) {
            ControladorMotorizado ctrl = (this.controlador != null)
                    ? this.controlador
                    : new ControladorMotorizado();

            ListadoMotorizadoFrame listado =
                    new ListadoMotorizadoFrame(
                            (JFrame) SwingUtilities.getWindowAncestor(this),
                            ctrl
                    );

            listado.setVisible(true);
        }
    }
}
