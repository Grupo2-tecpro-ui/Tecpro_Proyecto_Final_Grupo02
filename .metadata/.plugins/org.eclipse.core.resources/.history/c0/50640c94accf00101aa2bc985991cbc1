package repositorio;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.ArrayList;
import java.util.List;

public class MotorizadoSedeDAO {

	public boolean asignarRuta(int idMotorizado, int idSede, String fecha) {
	    String sql = "INSERT INTO motorizado_sede(idMotorizado, idSede, fechaAsignacion) VALUES (?,?,?)";

	    try (Connection cn = Conexion.getConexion();
	         PreparedStatement ps = cn.prepareStatement(sql)) {

	        ps.setInt(1, idMotorizado);
	        ps.setInt(2, idSede);
	        ps.setString(3, fecha);

	        ps.executeUpdate();
	        return true;

	    } catch (SQLException e) {
	        return false; // si falla es porque ya existe PK (duplicado por fecha)
	    }
	}
public List<MotorizadoSedeDTO> listarAsignaciones() {
    List<MotorizadoSedeDTO> lista = new ArrayList();

    String sql = """
        SELECT ms.idMotorizado, m.dni,
               CONCAT(m.nombres,' ',m.apellidos) AS nombreCompleto,
               s.nombre AS sede, ms.fechaAsignacion
        FROM motorizado_sede ms
        JOIN motorizado m ON ms.idMotorizado = m.id
        JOIN sede s ON ms.idSede = s.idSede
        ORDER BY ms.fechaAsignacion DESC;
    """;

    try (Connection con = Conexion.getConexion();
         PreparedStatement pst = con.prepareStatement(sql);
         ResultSet rs = pst.executeQuery()) {

        while (rs.next()) {
            lista.add(new MotorizadoSedeDTO(
                    rs.getInt("idMotorizado"),
                    rs.getString("dni"),
                    rs.getString("nombreCompleto"),
                    rs.getString("sede"),
                    rs.getDate("fechaAsignacion").toString()
            ));
        }

    } catch (Exception e) {
        e.printStackTrace();
    }

    return lista;
}
public boolean existeAsignacion(int idMotorizado, int idSede, String fecha) {

    String sql = """
        SELECT 1 FROM motorizado_sede
        WHERE idMotorizado = ?
        AND idSede = ?
        AND fechaAsignacion = ?
    """;

    try (Connection con = Conexion.getConexion();
         PreparedStatement pst = con.prepareStatement(sql)) {

        pst.setInt(1, idMotorizado);
        pst.setInt(2, idSede);
        pst.setString(3, fecha);

        ResultSet rs = pst.executeQuery();
        return rs.next(); // Si devuelve algo, YA existe

    } catch (Exception e) {
        e.printStackTrace();
        return true; // Mejor bloquear
    }
}
	
	
	
	
	
	
	
}
