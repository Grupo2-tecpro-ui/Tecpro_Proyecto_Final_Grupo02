    private static class DashboardPanel extends JPanel {

        private final ControladorMotorizado controlador;
        private final JLabel lblActivos;
        private final JLabel lblEntregasDia;
        private final JLabel lblConformesDia;
        private final BarChartPanel chartPanel;

        public DashboardPanel(ControladorMotorizado controlador) {
            this.controlador = controlador;

            setLayout(new BorderLayout(20, 20));
            setBackground(PROSEGUR_BLACK);

            // --------- Cards resumen (arriba) ----------
            JPanel cardsPanel = new JPanel(new GridLayout(1, 3, 20, 0));
            cardsPanel.setOpaque(false);

            lblActivos = createCardLabel("Motorizados Activos", "0");
            lblEntregasDia = createCardLabel("Entregas del día", "0");
            lblConformesDia = createCardLabel("Conformes del día", "0");

            cardsPanel.add(wrapCard(lblActivos));
            cardsPanel.add(wrapCard(lblEntregasDia));
            cardsPanel.add(wrapCard(lblConformesDia));

            add(cardsPanel, BorderLayout.NORTH);

            // --------- Gráfico (abajo) ----------
            chartPanel = new BarChartPanel();
            chartPanel.setPreferredSize(new Dimension(400, 260));
            chartPanel.setBorder(new EmptyBorder(20, 10, 10, 10));
            add(chartPanel, BorderLayout.CENTER);

            refrescarDatos();
        }

        private JLabel createCardLabel(String title, String value) {
            JLabel lbl = new JLabel("<html><center>" + title + "<br><span style='font-size:26px;'>"
                    + value + "</span></center></html>", SwingConstants.CENTER);
            lbl.setFont(new Font("Montserrat", Font.BOLD, 16));
            lbl.setForeground(PROSEGUR_BLACK);
            return lbl;
        }

        private JPanel wrapCard(JLabel content) {
            JPanel card = new JPanel(new BorderLayout());
            card.setBackground(PROSEGUR_YELLOW);
            card.setBorder(new EmptyBorder(15, 15, 15, 15));
            card.add(content, BorderLayout.CENTER);
            return card;
        }

        // ----------- ACTUALIZAR DATOS -------------
        private void refrescarDatos() {

            // Motorizados activos
            List<Motorizado> motorizados = InMemoryDatabase.getMotorizados();
            int activos = 0;
            for (Motorizado m : motorizados) {
                if ("Activo".equalsIgnoreCase(m.getEstado())) {
                    activos++;
                }
            }

            // Entregas del día
            String hoy = LocalDate.now().toString();
            List<Entrega> entregas = InMemoryDatabase.getEntregas();
            int entregasDia = 0;
            int conformesDia = 0;

            for (Entrega e : entregas) {
                if (e == null || !hoy.equals(e.getFecha())) continue;

                entregasDia += e.getCantidad();

                if (e.getDetalles() != null) {
                    for (DetalleEntrega d : e.getDetalles()) {
                        if (d != null && d.isConforme()) {
                            conformesDia++;
                        }
                    }
                }
            }

            lblActivos.setText(
                    "<html><center>Motorizados Activos<br><span style='font-size:26px;'>" +
                            activos + "</span></center></html>");
            lblEntregasDia.setText(
                    "<html><center>Entregas del día<br><span style='font-size:26px;'>" +
                            entregasDia + "</span></center></html>");
            lblConformesDia.setText(
                    "<html><center>Conformes del día<br><span style='font-size:26px;'>" +
                            conformesDia + "</span></center></html>");

            // Datos para gráfico
            Map<String, Integer> mapa = new LinkedHashMap<>();
            for (Entrega e : entregas) {
                if (e == null) continue;
                String dni = e.getDniMotorizado();
                mapa.put(dni, mapa.getOrDefault(dni, 0) + e.getCantidad());
            }

            // Top 6
            String[] etiquetas = mapa.keySet().stream().limit(6).toArray(String[]::new);
            int[] valores = new int[etiquetas.length];
            for (int i = 0; i < etiquetas.length; i++) valores[i] = mapa.get(etiquetas[i]);

            chartPanel.setData(etiquetas, valores);
        }

        // ESTE ES EL MÉTODO PARA REFRESCAR DESDE EL MAINMENU
        public void refrescarForzado() {
            refrescarDatos();
            repaint();
        }
    }

    // =====================================================================
    //                PANEL DE GRÁFICO DE BARRAS SIMPLE
    // =====================================================================
    private static class BarChartPanel extends JPanel {

        private String[] labels = new String[0];
        private int[] values = new int[0];

        public BarChartPanel() {
            setOpaque(false);
        }

        public void setData(String[] labels, int[] values) {
            this.labels = (labels != null) ? labels : new String[0];
            this.values = (values != null) ? values : new int[0];
            repaint();
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            if (labels.length == 0) return;

            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int width = getWidth();
            int height = getHeight();

            int max = 1;
            for (int v : values) if (v > max) max = v;

            int baseY = height - 40;
            int barWidth = (width - 60) / values.length;
            int x = 40;

            // EJE X
            g2.setColor(Color.LIGHT_GRAY);
            g2.drawLine(30, baseY, width - 20, baseY);

            for (int i = 0; i < values.length; i++) {
                int val = values[i];
                int barHeight = (int) ((height - 80) * (val / (double) max));
                int y = baseY - barHeight;

                // barra
                g2.setColor(PROSEGUR_YELLOW);
                g2.fillRoundRect(x, y, barWidth - 10, barHeight, 10, 10);

                // valor encima
                g2.setColor(Color.WHITE);
                g2.drawString(String.valueOf(val), x + (barWidth - 10) / 3, y - 5);

                // etiqueta
                g2.drawString(labels[i], x + (barWidth - 10) / 3, baseY + 15);

                x += barWidth;
            }

            g2.dispose();
        }
    }
