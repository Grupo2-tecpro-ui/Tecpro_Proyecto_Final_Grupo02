package repositorio;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

import Modelado.Entrega;
import Modelado.DetalleEntrega;

public class EntregaDAO {

    public int registrarEntrega(Entrega e) {
        int idGenerado = -1;

        String sql = "INSERT INTO entrega(dniMotorizado, cantidad, requestedCantidad, fecha) "
                   + "VALUES (?, ?, ?, ?)";

        try (Connection con = Conexion.getConexion();
             PreparedStatement pst = con.prepareStatement(sql, Statement.RETURN_GENERATED_KEYS)) {

            pst.setString(1, e.getDniMotorizado());
            pst.setInt(2, e.getCantidad());
            pst.setInt(3, e.getRequestedCantidad());
            pst.setString(4, e.getFecha());

            pst.executeUpdate();

            ResultSet rs = pst.getGeneratedKeys();
            if (rs.next()) idGenerado = rs.getInt(1);

        } catch (Exception ex) {
            ex.printStackTrace();
        }

        return idGenerado;
    }
}
