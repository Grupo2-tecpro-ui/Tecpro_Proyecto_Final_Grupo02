            card.add(content, BorderLayout.CENTER);
            return card;
        }

        private void refrescarDatos() {

            // ============================================
            // Obtener datos reales desde MySQL
            // ============================================
            List<Motorizado> motorizados = controlador.listarMotorizados();
            List<Entrega> entregas = controlador.listarEntregasBD();
            String hoy = LocalDate.now().toString();

            int activos = 0;
            int entregasDia = 0;
            int conformesDia = 0;

            for (Motorizado m : motorizados) {
                if ("Activo".equalsIgnoreCase(m.getEstado()))
                    activos++;
            }

            for (Entrega e : entregas) {
                if (e.getFecha().equals(hoy)) {
                    entregasDia += e.getCantidad();
                }
            }

            lblActivos.setText(
                "<html><div style='text-align:center;'>" +
                "Motorizados Activos<br><b>" + activos + "</b>" +
                "</div></html>"
            );

            lblEntregasDia.setText(
                "<html><div style='text-align:center;'>" +
                "Entregas del día<br><b>" + entregasDia + "</b>" +
                "</div></html>"
            );

            lblConformesDia.setText(
                "<html><div style='text-align:center;'>" +
                "Conformes<br><b>" + conformesDia + "</b>" +
                "</div></html>"
            );

            // ============================================
            // Construir gráfico por motorizado
            // ============================================
            Map<String, Integer> mapa = new LinkedHashMap<>();

            for (Entrega e : entregas) {
                String dni = e.getDniMotorizado();

                Motorizado m = motorizados.stream()
                        .filter(x -> x.getDni().equals(dni))
                        .findFirst()
                        .orElse(null);

                String nombre = (m != null) ? m.getNombres() + " " + m.getApellidos() : dni;

                mapa.put(nombre, mapa.getOrDefault(nombre, 0) + e.getCantidad());
            }

            String[] labels = mapa.keySet().stream().limit(6).toArray(String[]::new);
            int[] values = mapa.values().stream().limit(6).mapToInt(i -> i).toArray();

            chartPanel.setData(labels, values);
        }

        public void refrescarForzado() {
            refrescarDatos();
            revalidate();
            repaint();
        }
    }

    private static class BarChartPanel extends JPanel {

        private String[] labels = new String[0];
        private int[] values = new int[0];

        public BarChartPanel() {
            setOpaque(true);
            setBackground(PROSEGUR_BLACK);
        }

        public void setData(String[] labels, int[] values) {
            this.labels = labels;
            this.values = values;
            repaint();
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            if (labels.length == 0) return;

            Graphics2D g2 = (Graphics2D) g;

            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            int width = getWidth();
            int height = getHeight();

            int max = 1;
            for (int v : values) max = Math.max(max, v);

            int baseY = height - 40;
            int barWidth = (width - 80) / values.length;
            int x = 40;

            g2.setColor(Color.LIGHT_GRAY);
            g2.drawLine(30, baseY, width - 20, baseY);

            g2.setFont(new Font("Montserrat", Font.PLAIN, 11));

            for (int i = 0; i < values.length; i++) {
                int barHeight = (int) ((height - 80) * (values[i] / (double) max));
                int y = baseY - barHeight;

                g2.setColor(PROSEGUR_YELLOW);
                g2.fillRoundRect(x, y, barWidth - 12, barHeight, 10, 10);

                g2.setColor(Color.WHITE);
                g2.drawString(String.valueOf(values[i]), x + 5, y - 5);

                g2.drawString(labels[i], x, baseY + 15);
                x += barWidth;
            }
        }
    }
