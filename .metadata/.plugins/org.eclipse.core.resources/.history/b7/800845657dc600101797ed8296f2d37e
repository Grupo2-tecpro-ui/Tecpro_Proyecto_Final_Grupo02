package repositorio;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

import Modelado.Motorizado;
import conexion.ConexionMySql;

public class MotorizadoDAO {

    // Helpers para convertir String -> java.sql.Date
    private java.sql.Date toSqlDate(String s) {
        if (s == null) return null;
        s = s.trim();
        if (s.isEmpty()) return null;
        try {
            return java.sql.Date.valueOf(s); // formato: yyyy-MM-dd
        } catch (Exception e) {
            return null;
        }
    }

    // ==========================
    // INSERTAR (SP agregarMotorizado)
    // ==========================
    public boolean agregar(Motorizado m) {
        String sql = "{CALL agregarMotorizado(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)}";

        try (Connection cn = ConexionMySql.getConexion();
             CallableStatement cs = cn.prepareCall(sql)) {

            cs.setString(1, m.getDni());
            cs.setString(2, m.getNombres());
            cs.setString(3, m.getApellidos());
            cs.setString(4, m.getCelular());
            cs.setString(5, m.getPlaca());
            cs.setString(6, m.getMarca());
            cs.setString(7, m.getModelo());
            cs.setString(8, m.getBrevete());

            // vencBrevete (DATE)
            java.sql.Date dVenc = toSqlDate(m.getVencBrevete());
            if (dVenc != null) cs.setDate(9, dVenc);
            else cs.setNull(9, Types.DATE);

            cs.setBoolean(10, m.isSoat());
            cs.setString(11, m.getEstado());

            // fechaIngreso (DATE)
            java.sql.Date dIng = toSqlDate(m.getFechaIngreso());
            if (dIng != null) cs.setDate(12, dIng);
            else cs.setNull(12, Types.DATE);

            cs.setString(13, m.getContrato());
            cs.setInt(14, m.getTarjetasAsignadas());
            cs.setBoolean(15, m.isDiaRuta());

            // fechaTarjetas (DATE)
            java.sql.Date dRuta = toSqlDate(m.getFechaTarjetas());
            if (dRuta != null) cs.setDate(16, dRuta);
            else cs.setNull(16, Types.DATE);

            cs.setInt(17, m.getIdSede());

            cs.executeUpdate();
            return true;

        } catch (Exception e) {
            e.printStackTrace();
            return false;
        }
    }

    // ==========================
    // EDITAR POR DNI (SP editarMotorizadoPorDni)
    // ==========================
    public boolean editarPorDni(String dni, String nuevosNombres,
                                String nuevosApellidos, String nuevoCelular,
                                int nuevasTarjetas, String nuevoEstado) {

        String sql = "{CALL editarMotorizadoPorDni(?,?,?,?,?,?)}";

        try (Connection cn = ConexionMySql.getConexion();
             CallableStatement cs = cn.prepareCall(sql)) {

            cs.setString(1, dni);
            cs.setString(2, nuevosNombres);
            cs.setString(3, nuevosApellidos);
            cs.setString(4, nuevoCelular);
            cs.setInt(5, nuevasTarjetas);
            cs.setString(6, nuevoEstado);

            cs.executeUpdate();
            return true;

        } catch (Exception e) {
            e.printStackTrace();
            return false;
        }
    }

    // ==========================
    // ELIMINAR POR DNI (SP eliminarMotorizadoPorDni)
    // ==========================
    public boolean eliminarPorDni(String dni) {
        String sql = "{CALL eliminarMotorizadoPorDni(?)}";

        try (Connection cn = ConexionMySql.getConexion();
             CallableStatement cs = cn.prepareCall(sql)) {

            cs.setString(1, dni);
            cs.executeUpdate();
            return true;

        } catch (Exception e) {
            e.printStackTrace();
            return false;
        }
    }

    // ==========================
    // EXISTE DNI ?
    // ==========================
    public boolean existeDni(String dni) {
        String sql = "SELECT 1 FROM motorizado WHERE dni = ?";
        try (Connection cn = ConexionMySql.getConexion();
             PreparedStatement ps = cn.prepareStatement(sql)) {

            ps.setString(1, dni);
            try (ResultSet rs = ps.executeQuery()) {
                return rs.next();
            }

        } catch (Exception e) {
            e.printStackTrace();
            return false;
        }
    }

    // ==========================
    // LISTAR TODOS
    // ==========================
    public List<Motorizado> listarTodos() {
        List<Motorizado> lista = new ArrayList<>();
        String sql = "SELECT * FROM motorizado";

        try (Connection cn = ConexionMySql.getConexion();
             PreparedStatement ps = cn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                Motorizado m = new Motorizado(
                        rs.getInt("id"),
                        rs.getString("dni"),
                        rs.getString("nombres"),
                        rs.getString("apellidos"),
                        rs.getString("celular"),
                        rs.getString("placa"),
                        rs.getString("marca"),
                        rs.getString("modelo"),
                        rs.getString("brevete"),
                        rs.getString("vencBrevete"),
                        rs.getBoolean("soat"),
                        rs.getString("estado"),
                        rs.getString("fechaIngreso"),
                        rs.getString("contrato"),
                        rs.getInt("tarjetasAsignadas"),
                        rs.getBoolean("diaRuta"),
                        rs.getString("fechaTarjetas"),
                        rs.getInt("idSede")
                );
                lista.add(m);
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return lista;
    }

    // ==========================
    // BUSCAR POR DNI (para editar)
    // ==========================
    public Motorizado buscarPorDni(String dni) {
        String sql = "SELECT * FROM motorizado WHERE dni = ?";

        try (Connection cn = ConexionMySql.getConexion();
             PreparedStatement ps = cn.prepareStatement(sql)) {

            ps.setString(1, dni);

            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    return new Motorizado(
                            rs.getInt("id"),
                            rs.getString("dni"),
                            rs.getString("nombres"),
                            rs.getString("apellidos"),
                            rs.getString("celular"),
                            rs.getString("placa"),
                            rs.getString("marca"),
                            rs.getString("modelo"),
                            rs.getString("brevete"),
                            rs.getString("vencBrevete"),
                            rs.getBoolean("soat"),
                            rs.getString("estado"),
                            rs.getString("fechaIngreso"),
                            rs.getString("contrato"),
                            rs.getInt("tarjetasAsignadas"),
                            rs.getBoolean("diaRuta"),
                            rs.getString("fechaTarjetas"),
                            rs.getInt("idSede")
                    );
                }
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return null;
    }
}
