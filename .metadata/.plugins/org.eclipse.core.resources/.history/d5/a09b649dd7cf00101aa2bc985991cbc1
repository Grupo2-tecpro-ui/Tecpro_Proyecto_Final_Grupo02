public List<MotorizadoSedeDTO> listarMotorizadosBase() {
    List<MotorizadoSedeDTO> lista = new ArrayList<>();

    String sql = """
        SELECT id, dni,
               CONCAT(nombres,' ',apellidos) AS nombreCompleto,
               idSede,
               fechaTarjetas
        FROM motorizado
        ORDER BY id ASC;
    """;

    try (Connection con = Conexion.getConexion();
         PreparedStatement pst = con.prepareStatement(sql);
         ResultSet rs = pst.executeQuery()) {

        while (rs.next()) {
            lista.add(new MotorizadoSedeDTO(
                rs.getInt("id"),
                rs.getString("dni"),
                rs.getString("nombreCompleto"),
                sedeString(rs.getInt("idSede")),  
                rs.getDate("fechaTarjetas").toString()
            ));
        }

    } catch (Exception e) {
        e.printStackTrace();
    }

    return lista;
}

private String sedeString(int idSede) {
    return switch (idSede) {
        case 1 -> "Miraflores";
        case 2 -> "Surco";
        case 3 -> "Tambo Norte";
        default -> "Sin sede";
    };
}
	
	
	
	
}
