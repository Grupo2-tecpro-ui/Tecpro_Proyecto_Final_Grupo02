package repositorio;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;

public class MotorizadoSedeDAO {

	public boolean asignarRuta(int idMotorizado, int idSede, String fecha) {
	    String sql =  "INSERT INTO motorizado_sede(idMotorizado, idSede, fechaAsignacion, tarjetasAsignadasDia) VALUES (?,?,?,?)";

	    try (Connection cn = Conexion.getConexion();
	         PreparedStatement ps = cn.prepareStatement(sql)) {

	        ps.setInt(1, idMotorizado);
	        ps.setInt(2, idSede);
	        ps.setString(3, fecha);

	        ps.executeUpdate();
	        return true;

	    } catch (SQLException e) {
	        return false; 
	    }
	}
	public List<MotorizadoSedeDTO> listarAsignaciones() {
	    List<MotorizadoSedeDTO> lista = new ArrayList<>();

	    String sql = """
	        SELECT 
	            ms.idMotorizado,
	            m.dni,
	            CONCAT(m.nombres, ' ', m.apellidos) AS nombreCompleto,
	            s.nombre AS sede,
	            ms.fechaAsignacion AS fecha
	        FROM motorizado_sede ms
	        JOIN motorizado m ON ms.idMotorizado = m.id
	        JOIN sede s ON ms.idSede = s.idSede
	        ORDER BY ms.fechaAsignacion DESC, m.dni;
	    """;

	    try (Connection con = Conexion.getConexion();
	         PreparedStatement pst = con.prepareStatement(sql);
	         ResultSet rs = pst.executeQuery()) {

	        while (rs.next()) {
	            lista.add(new MotorizadoSedeDTO(
	                    rs.getInt("idMotorizado"),
	                    rs.getString("dni"),
	                    rs.getString("nombreCompleto"),
	                    rs.getString("sede"),
	                    rs.getString("fecha")
	            ));
	        }

	    } catch (Exception e) {
	        e.printStackTrace();
	    }

	    return lista;
	}

